# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env or put it in a shared ZIP.

PORT=5001

# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/edutrack
# Atlas:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/edutrack
MONGO_URI=mongodb://127.0.0.1:27017/edutrack

# Long random string for JWT signing
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Optional — essay AI / chatbot
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Flask ML service
ML_API_URL=http://127.0.0.1:5000

# Password-reset email links
FRONTEND_URL=http://localhost:5173

# Allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional contact inbox
SUPPORT_EMAIL=admin@edutrack.lk

# Optional SMTP for forgot-password emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="EduTrack <noreply@edutrack.lk>"
